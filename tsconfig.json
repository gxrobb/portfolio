{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Next keeps .next/dev/types in "include", but in a Pages Router app the dev
  // and build validator.ts files both declare the same global types. Next's
  // CLI type check (the default) doesn't filter them, so `build` and
  // `typecheck` fail with duplicate identifiers after running `dev`.
  "exclude": ["node_modules", ".next/dev/types"]
}
